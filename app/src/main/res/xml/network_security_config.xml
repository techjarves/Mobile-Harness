<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Cleartext is permitted so self-hosted model servers on the local network or Tailscale work.
      App code only allows http:// for local/private addresses (see network/LocalNetwork.kt);
      every other provider URL must use HTTPS.
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
